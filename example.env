# Copy to .env and load it into the environment of the simulation, e.g.
#   set -a; source .env; set +a

# POST /market_results endpoint of the BRP; leave empty to send nothing
BRP_MARKET_RESULTS_URL=https://mas4te.nowum.fh-aachen.de/brp-api/market_results

# MARKET_RESULTS_PASSWORD of the BRP (not the password of the agents)
MARKET_RESULTS_PASSWORD=change-me-too
